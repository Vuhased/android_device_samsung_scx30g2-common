# RIL daemons - Android 9: AOSP rild (hardware/ril) lives in /vendor/bin/hw and
# talks to Java through HIDL (android.hardware.radio), so no rild sockets here.
# Dual-SIM / shim handling still needs work, see README.

service ril-daemon /vendor/bin/hw/rild -l /system/lib/libreference-ril_sp.so -m w -n 0
    class main
    disabled
    user root
    group radio cache inet misc audio log readproc wakelock shell
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    setenv LD_SHIM_LIBS /vendor/lib/libril.so|libril_shim.so

service ril-daemon2 /vendor/bin/hw/rild -l /system/lib/libreference-ril_sp.so -m w -n 1
    class main
    disabled
    user root
    group radio cache inet misc audio log readproc wakelock shell
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    setenv LD_SHIM_LIBS /vendor/lib/libril.so|libril_shim.so

service ril-daemon3 /vendor/bin/hw/rild -l /system/lib/libreference-ril_sp.so -m w -n 2
    class main
    disabled
    user root
    group radio cache inet misc audio log readproc wakelock shell
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    setenv LD_SHIM_LIBS /vendor/lib/libril.so|libril_shim.so
